# Core APIs base URL. Do not include a trailing slash.
VITE_API_BASE_URL=http://localhost:3000

# Clerk publishable keys are safe for browser use. Never put a Clerk secret key
# or R2 credentials in a VITE_* variable because Vite bundles them publicly.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# The Web-ERP Downloads page lists this erp-app release channel by default.
# Use "internal" for staff testing and "stable" for approved production builds.
VITE_MOBILE_RELEASE_CHANNEL=stable
