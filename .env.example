# Core APIs base URL. Do not include a trailing slash.
VITE_API_BASE_URL=http://localhost:3000

# Clerk publishable keys are safe for browser use. Never put a Clerk secret key
# or R2 credentials in a VITE_* variable because Vite bundles them publicly.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# The Web-ERP Downloads page lists this erp-app release channel by default.
# Use "internal" for staff testing and "stable" for approved production builds.
VITE_MOBILE_RELEASE_CHANNEL=stable

# Public Android installer shown on /downloads. Use either a public R2 custom
# domain URL or a Core APIs endpoint that redirects to a short-lived signed URL.
# Never place R2 access keys or secret keys in this file.
VITE_ANDROID_APP_DOWNLOAD_URL=https://downloads.example.com/mobile/android/stable/erp-app.apk
VITE_ANDROID_APP_VERSION=1.0.0
VITE_ANDROID_APP_SIZE=Pending build
VITE_ANDROID_APP_UPDATED_AT=2026-10-25

# Optional integrity value displayed to users. Leave empty until CI calculates
# the SHA-256 of the signed APK.
VITE_ANDROID_APP_SHA256=
